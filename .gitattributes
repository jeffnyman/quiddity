#
# Establish project-wide standard of LF line endings.
#
# `text=auto` detects text vs. binary by content, so the rules below cover
# only two cases: where that detection must not be trusted, and where the
# line ending must not be LF.
#

* text=auto eol=lf

#
# Files whose line endings must not be LF.
#

*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf
*.psm1     text eol=crlf
*.sln      text eol=crlf

#
# Story files and resource bundles are binary. Content detection would find
# this anyway, but saying so keeps a short one from ever being normalized.
#

*.z[1-8]   binary
*.[zbg]lb  binary
*.*blorb   binary
*.ulx      binary
*.ttf      binary

#
# Diff drivers, so hunk headers name the enclosing type or member.
#

*.c        diff=cpp
*.cc       diff=cpp
*.cpp      diff=cpp
*.cxx      diff=cpp
*.h        diff=cpp
*.hh       diff=cpp
*.hpp      diff=cpp

#
# Exclude from `git archive`, which is what produces GitHub's "Download ZIP"
# and release source tarballs. Someone taking the project that way is not
# cloning it, so repository plumbing is noise to them.
#

.editorconfig  export-ignore
.gitattributes export-ignore
.gitignore     export-ignore
.github/*      export-ignore
.vscode/*      export-ignore
specs/*        export-ignore
